# Template biến môi trường. Copy sang .env để override:
#   copy .env.example .env   (Windows) / cp .env.example .env (Linux)
# File .env đã ignore khỏi git — không commit secret thật.
# Không có .env, compose dùng giá trị default sau ":-" (đủ chạy local).

# Postgres (dùng trong compose cho postgres + DATABASE_URL)
POSTGRES_DB=crypto_db
POSTGRES_USER=admin
# Đổi password khi demo portfolio: POSTGRES_PASSWORD=doi-pass-manh-o-day
POSTGRES_PASSWORD=secret

# Chạy local ngoài Docker (không cần khi chạy bằng compose)
# DATABASE_URL=postgresql://admin:secret@localhost:5432/crypto_db

# Môi trường cho PostgresResource.table(): local | staging | prod
# (thiếu biến này, Dagster CLI local sẽ lỗi lúc load definitions)
DAGSTER_ENVIRONMENT=local
