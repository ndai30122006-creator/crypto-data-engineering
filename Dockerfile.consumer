FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/consumer \
    UV_LINK_MODE=copy \
    PATH="/opt/consumer/.venv/bin:$PATH"

WORKDIR /opt/consumer

# git cho uv clone git deps (jlogger) lúc sync.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock .python-version README.md ./
# Chỉ cần deps (kafka/websocket); ingestion chạy trực tiếp qua PYTHONPATH,
# không cài project (tránh hatch build thiếu dagster_project).
RUN uv sync --frozen --no-dev --no-install-project

COPY ingestion ./ingestion

CMD ["python", "-m", "ingestion.binance_consumer"]
